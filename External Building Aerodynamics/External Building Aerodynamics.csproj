<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- Rhino 8's Grasshopper host runs plugins on .NET 7, not .NET 8/9 — McNeel's own
         templates and the published Grasshopper/RhinoCommon NuGet packages only ship
         net48 and net7.0(-windows) asset groups (there is no net8.0 group yet), so
         net7.0-windows is the correct "modern" TFM here, not net8.0-windows. This drops
         Rhino 7 (net48) support entirely and requires Rhino 8 — see README for the
         SetDotNetRuntime workaround this removes. -->
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <Version>1.0</Version>
    <Title>External Building Aerodynamics</Title>
    <Description>Description of External Building Aerodynamics</Description>
    <TargetExt>.gha</TargetExt>
  </PropertyGroup>

  <ItemGroup>
    <!-- McNeel publish Grasshopper/RhinoCommon as NuGet reference-only packages (ExcludeAssets
         "runtime" keeps them out of the output — Rhino provides the real DLLs at load time).
         This replaces hardcoded local install paths (previously "C:\Program Files\Rhino 7\...")
         so the project builds without a Rhino install, including on CI or non-Windows. -->
    <!-- Pinned to the first stable Rhino 8 release (not whatever happens to be on a given
         dev/test machine) so the plugin stays forward-compatible with every Rhino 8 user
         (McNeel's own guidance: build against the lowest SDK version you want to support —
         these reference-only packages are forward- but not backward-compatible). A previous
         newer pin here caused a "built against a newer minor SDK" breakpoint error on Rhino
         8 installs older than that pin. -->
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <!-- GH_AssemblyInfo.Icon is a System.Drawing.Bitmap; on net7.0-windows that type no
         longer ships in the base framework and needs this package explicitly. NuGet
         resolves this package's ref assembly correctly on a net*-windows TFM without
         UseWindowsForms/UseWPF set, but silently skips copying the real runtime DLL to
         the output — every other dependency copies fine, only this one doesn't. Confirmed
         by loading the built .gha standalone: it threw "Could not load ... System.Drawing.Common"
         and Grasshopper couldn't recognize any of the plugin's components as a result.
         ExcludeAssets="runtime" + an explicit HintPath Reference below (same pattern as the
         VTK DLLs) forces the real DLL into the output regardless of that NuGet quirk. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <PackageReference Include="JsonSubTypes" Version="1.5.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RestSharp" Version="106.15.0" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Was hardcoded to a specific developer's absolute clone path
         (C:\Users\darre\...\vtk_dll\...); these DLLs are already checked into the repo under
         vtk_dll/, so resolve them relative to this project file instead. -->
    <Reference Include="SimScale.Sdk">
      <HintPath>$(MSBuildThisFileDirectory)..\vtk_dll\SimScale.Sdk.dll</HintPath>
	</Reference>
	<Reference Include="Kitware.mummy.Runtime">
		<HintPath>$(MSBuildThisFileDirectory)..\vtk_dll\Kitware.mummy.Runtime.dll</HintPath>
	</Reference>
	<Reference Include="Kitware.VTK">
		<HintPath>$(MSBuildThisFileDirectory)..\vtk_dll\Kitware.VTK.dll</HintPath>
	</Reference>
  </ItemGroup>

  <Target Name="CopySystemDrawingCommonRuntime" AfterTargets="Build">
    <!-- A plain <Reference> alongside the PackageReference above gets silently deduped by
         MSBuild (same assembly simple name), so it never actually lands in the output.
         Copy the real runtime DLLs straight from the NuGet cache instead, using the paths
         GeneratePathProperty exposes. Also grabs Microsoft.Win32.SystemEvents.dll, System.Drawing.Common's
         own runtime dependency, which has the identical copy problem. -->
    <ItemGroup>
      <_MissingRuntimeDlls Include="$(PkgSystem_Drawing_Common)\lib\net7.0\System.Drawing.Common.dll" />
      <_MissingRuntimeDlls Include="$(NuGetPackageRoot)microsoft.win32.systemevents\8.0.0\runtimes\win\lib\net7.0\Microsoft.Win32.SystemEvents.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_MissingRuntimeDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)'=='Windows_NT'">
    <Exec Command="xcopy /Y &quot;$(TargetDir)*&quot; &quot;$(SolutionDir).\latest_stable\SimScale\src&quot; /E /I&#xD;&#xA;powershell -Command &quot;Compress-Archive -Path '$(SolutionDir).\latest_stable\*' -DestinationPath '$(SolutionDir).\latest_stable\latest_stable.zip' -Force&quot;&#xD;&#xA;" />
  </Target>
</Project>