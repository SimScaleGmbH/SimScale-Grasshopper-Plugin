<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- Reverted from net7.0-windows back to net48. The net7.0-windows migration got
         everything else working (project lookup, download, extraction) but hit a hard
         wall in vtk_dll/Kitware.VTK.dll + Kitware.mummy.Runtime.dll: that VTK .NET
         wrapper is itself built for .NET Framework (its own referenced assemblies include
         System.Windows.Forms, System.Drawing, mscorlib — no netstandard/.NET Core surface
         at all) and its native companion DLL fails to load under .NET Core's stricter
         assembly loader ("Could not load file or assembly
         'Kitware.mummy.Runtime.Unmanaged.dll'... only single file assemblies are
         supported"). That's a structural incompatibility in a vendored binary we have no
         source for, not something fixable from this project file. net48 is proven working
         end-to-end and is what these vendored DLLs actually target — see README's
         SetDotNetRuntime → NETFramework step, which is required again. -->
    <TargetFramework>net48</TargetFramework>
    <Version>1.0</Version>
    <Title>External Building Aerodynamics</Title>
    <Description>Description of External Building Aerodynamics</Description>
    <TargetExt>.gha</TargetExt>
  </PropertyGroup>

  <ItemGroup>
    <!-- McNeel publish Grasshopper/RhinoCommon as NuGet reference-only packages (ExcludeAssets
         "runtime" keeps them out of the output — Rhino provides the real DLLs at load time).
         This replaces hardcoded local install paths (previously "C:\Program Files\Rhino 7\...")
         so the project builds without a Rhino install, including on CI or non-Windows. -->
    <!-- Pinned to the first stable Rhino 8 release (not whatever happens to be on a given
         dev/test machine) so the plugin stays forward-compatible with every Rhino 8 user
         (McNeel's own guidance: build against the lowest SDK version you want to support —
         these reference-only packages are forward- but not backward-compatible). A previous
         newer pin here caused a "built against a newer minor SDK" breakpoint error on Rhino
         8 installs older than that pin. -->
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <PackageReference Include="JsonSubTypes" Version="1.5.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Pinned to the version the vendored, precompiled vtk_dll/SimScale.Sdk.dll (no source
         available to rebuild it here) was actually built against, not the "latest patch"
         a prior commit bumped this to. RestSharp made a breaking internal signature change
         to RestClient.AddHandler somewhere in the 106.x line without bumping AssemblyVersion
         (still 106.0.0.0), so 106.15.0 loads fine but throws a MethodAccessException the
         moment SimScale.Sdk.Client.ApiClient.Exec actually calls into RestClient — confirmed
         by reflecting on SimScale.Sdk.dll's own referenced assembly info and by the version
         this project used before an unrelated "bump to latest patch" commit changed it. -->
    <PackageReference Include="RestSharp" Version="106.10.1" />
    <!-- net48 needs these as explicit package references (System.IO.Compression.ZipArchive
         isn't in the base Framework the way it is on .NET Core); used for the
         SharpZipLib → System.IO.Compression zip-extraction fix. -->
    <PackageReference Include="System.IO.Compression.ZipFile" Version="4.3.0" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <!-- YamlDotNet was removed: Rhino 8 ships its own older YamlDotNet.dll in its System
         folder and loads it before any plugin, which collides with this plugin's own copy
         (same simple name, different version — "Could not load file or assembly
         'YamlDotNet, Version=13.0.0.0'... Could not find or load a specific file" even
         though the correct file is sitting right next to this assembly). api_keys.cs now
         parses its two-field YAML config by hand instead. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Was hardcoded to a specific developer's absolute clone path
         (C:\Users\darre\...\vtk_dll\...); these DLLs are already checked into the repo under
         vtk_dll/, so resolve them relative to this project file instead. -->
    <Reference Include="SimScale.Sdk">
      <HintPath>$(MSBuildThisFileDirectory)..\vtk_dll\SimScale.Sdk.dll</HintPath>
	</Reference>
	<Reference Include="Kitware.mummy.Runtime">
		<HintPath>$(MSBuildThisFileDirectory)..\vtk_dll\Kitware.mummy.Runtime.dll</HintPath>
	</Reference>
	<Reference Include="Kitware.VTK">
		<HintPath>$(MSBuildThisFileDirectory)..\vtk_dll\Kitware.VTK.dll</HintPath>
	</Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)'=='Windows_NT'">
    <Exec Command="xcopy /Y &quot;$(TargetDir)*&quot; &quot;$(SolutionDir).\latest_stable\SimScale\src&quot; /E /I&#xD;&#xA;powershell -Command &quot;Compress-Archive -Path '$(SolutionDir).\latest_stable\*' -DestinationPath '$(SolutionDir).\latest_stable\latest_stable.zip' -Force&quot;&#xD;&#xA;" />
  </Target>
</Project>